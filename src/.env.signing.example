# macOS Code Signing & Notarization Credentials
# Copy this file to .env.signing:  cp .env.signing.example .env.signing
#
# This file is sourced by scripts/sign-and-notarize.sh.
# NEVER commit .env.signing — it contains secrets.

# ---------------------------------------------------------------------------
# Signing identity (auto-detected from keychain if not set)
# ---------------------------------------------------------------------------

# Your Developer ID Application certificate name or SHA-1 hash.
# Find yours with:  security find-identity -v -p codesigning
# export SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# ---------------------------------------------------------------------------
# Notarization credentials (required for --notarize flag)
# ---------------------------------------------------------------------------

# Your Apple ID email address
# export APPLE_ID="your@email.com"

# Your Apple Developer Team ID (visible at https://developer.apple.com/account)
# export APPLE_TEAM_ID="XXXXXXXXXX"

# App-specific password generated at https://appleid.apple.com
# Go to: Sign In → App-Specific Passwords → Generate
# export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# ---------------------------------------------------------------------------
# Windows Code Signing (Authenticode via Azure Key Vault)
# ---------------------------------------------------------------------------
# Required to eliminate the "Windows protected your PC" SmartScreen warning.
# Uses AzureSignTool with an EV certificate stored in Azure Key Vault.
#
# Add these as GitHub repository secrets:
#   - AZURE_KEY_VAULT_URI           → Key Vault URL (e.g. https://xxx.vault.azure.net/)
#   - AZURE_KEY_VAULT_CERT_NAME    → Certificate name in Key Vault
#   - AZURE_KEY_VAULT_CLIENT_ID    → Azure AD Application (client) ID
#   - AZURE_KEY_VAULT_CLIENT_SECRET → Azure AD Application client secret
#   - AZURE_KEY_VAULT_TENANT_ID    → Azure AD tenant ID
#
# The CI workflows automatically detect these secrets and sign the
# MSI/NSIS installers via AzureSignTool + TAURI_WINDOWS_SIGN_COMMAND.
#
# Local signing (for testing):
#   dotnet tool install --global AzureSignTool
#   AzureSignTool sign -kvu "https://xxx.vault.azure.net/" \
#     -kvc "CertName" -kvi "client-id" -kvs "client-secret" \
#     --azure-key-vault-tenant-id "tenant-id" \
#     -tr http://timestamp.globalsign.com/tsa/advanced -td sha256 "file.msi"
