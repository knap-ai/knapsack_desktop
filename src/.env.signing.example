# macOS Code Signing & Notarization Credentials
# Copy this file to .env.signing:  cp .env.signing.example .env.signing
#
# This file is sourced by scripts/sign-and-notarize.sh.
# NEVER commit .env.signing — it contains secrets.

# ---------------------------------------------------------------------------
# Signing identity (auto-detected from keychain if not set)
# ---------------------------------------------------------------------------

# Your Developer ID Application certificate name or SHA-1 hash.
# Find yours with:  security find-identity -v -p codesigning
# export SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# ---------------------------------------------------------------------------
# Notarization credentials (required for --notarize flag)
# ---------------------------------------------------------------------------

# Your Apple ID email address
# export APPLE_ID="your@email.com"

# Your Apple Developer Team ID (visible at https://developer.apple.com/account)
# export APPLE_TEAM_ID="XXXXXXXXXX"

# App-specific password generated at https://appleid.apple.com
# Go to: Sign In → App-Specific Passwords → Generate
# export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
