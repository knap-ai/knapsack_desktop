# Knapsack Environment Variables
# Copy this file to .env:  cp .env.example .env
#
# This file is sourced by `npm run tauri` before the build starts.
#
# VITE_ prefix: Vite (the frontend bundler) exposes any variable starting
# with VITE_ to the React frontend via `import.meta.env.VITE_*`.
# Variables WITHOUT the VITE_ prefix are only available to the Rust backend
# at compile time (via the env!() macro) or to Node.js build plugins.

# ---------------------------------------------------------------------------
# Required -- the build will fail without this
# ---------------------------------------------------------------------------

# URL of the Knapsack backend API server used for OAuth token exchange.
# Default points to the knap.ai cloud backend (used by official DMG releases).
# For self-hosted mode, set GOOGLE_CLIENT_SECRET instead (see README).
VITE_KN_API_SERVER=https://api.knapsack.ai
VITE_KN_STUDIO_SERVER=https://studio.knapsack.ai

# ---------------------------------------------------------------------------
# Optional -- Microsoft integration
# ---------------------------------------------------------------------------

# Azure AD application (client) ID for Microsoft OAuth sign-in.
# The default value below is the official Knapsack Azure AD app ID.
# Override only if you are using your own Azure AD app registration.
# If unset or set to "unused", the build falls back to the official app ID.
MICROSOFT_CLIENT_ID=0edbd2c2-902d-4678-9dc2-9de46d769973

# ---------------------------------------------------------------------------
# Optional -- Google integration
# ---------------------------------------------------------------------------

# Google OAuth 2.0 client ID for sign-in and Drive picker.
# Create one at https://console.cloud.google.com > APIs & Services > Credentials.
VITE_GOOGLE_CLIENT_ID=963137762742-tqs7tiv9bkh80t5io8hm5q8e798ab85s.apps.googleusercontent.com

# Google API key for Drive file listing.
# Create one at https://console.cloud.google.com > APIs & Services > Credentials.
VITE_GOOGLE_DEVELOPER_KEY=

# ---------------------------------------------------------------------------
# Optional -- Error tracking (Sentry)
# ---------------------------------------------------------------------------

# Sentry DSN for frontend (React) error reporting.
VITE_SENTRY_DSN=

# Sentry DSN for backend (Rust) error reporting.
SENTRY_DSN=

# Sentry auth token for uploading source maps during production builds.
# Generate at https://sentry.io > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
